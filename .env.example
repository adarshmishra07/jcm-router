# TypeSafe API key (required). Get one at https://typesafe.ai. Never commit the real one.
TYPESAFE_API_KEY=apikey_your_key_here
# Port the proxy listens on. Point Claude Code at it with ANTHROPIC_BASE_URL=http://localhost:PORT
PORT=8787
# Where routed requests are forwarded.
ANTHROPIC_UPSTREAM=https://api.anthropic.com
# TypeSafe API base URL. Only change it to point at a fake server during testing.
TYPESAFE_API_URL=https://api.typesafe.ai
# 1 or true: compute and log decisions but forward every request unchanged (for tuning).
ROUTER_DRY_RUN=0
# 1 or true (default): include the first 300 chars of each new prompt in decisions.jsonl. 0 to keep prompts out of logs.
ROUTER_LOG_PROMPTS=1
# Where last.json (latest decision, read by the statusline) and decisions.jsonl (full log) are written. Default: ~/.claude-router
ROUTER_STATE_DIR=
# subagents or all (default). all: the main chat is routed too, but only while a model switch is cheap (prompt caches
# are per model, so a switch re-caches the whole history). subagents: never touch the main chat.
ROUTER_SCOPE=all
# 1 or true: let a large main-chat turn still be upgraded to a more expensive model when Jev is confident it is hard.
# Never downgrades. This deliberately spends more for quality. Default 0.
ROUTER_MAIN_UPGRADES=0
